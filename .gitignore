# Rust / Cargo build artifacts
/target/
/target-*/
**/*.rs.bk

# Keep the GitHub repository focused on README and runnable source code.
# Full design notes are local-only for this upload style.
/docs/

# This workspace keeps real code under crates/. Ignore unused root-level
# source/test folders if they are accidentally populated later.
/src/
/tests/

# Local Cargo configuration.
# Do not commit machine-specific target dirs or linker paths.
/.cargo/config.toml
!/.cargo/
!/.cargo/config.example.toml

# Runtime data generated by rustkv-server demos
*.aof
*.rdb
*.log

# Benchmark / coverage outputs
/coverage/
/tarpaulin-report.html
/lcov.info

# Local environment files
.env
.env.*

# Editor / IDE files
/.vscode/
/.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
